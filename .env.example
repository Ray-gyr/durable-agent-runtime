# Copy to .env. Every value except BUFFER_DEBUG_TOKEN has a working default.

# Protects POST /v1/buffer/flush and POST /v1/backups.
BUFFER_DEBUG_TOKEN=change-me

# Storage. DATA_DIR holds runtime.db and objects/ unless overridden individually.
# DATA_DIR=./data
# DATABASE_PATH=./data/runtime.db
# OBJECT_STORE_ROOT=./data/objects
# OBJECT_STORE_PREFIX=local

# Buffer flushing.
# BUFFER_FLUSH_BATCH_SIZE=100
# BUFFER_FLUSH_THRESHOLD=100
# BUFFER_FLUSH_LEASE_SECONDS=300
# BUFFER_WORKER_POLL_SECONDS=5

# Object store fault injection (off by default).
# FAULT_PUT_FAILURES=0        # fail the first N puts before writing
# FAULT_PUT_LOST_ACKS=0       # write the next N objects, then report failure
# FAULT_PUT_FAILURE_RATE=0    # seeded random pre-write failures, 0..1
# FAULT_PUT_LATENCY_MS=0
# FAULT_SEED=0
